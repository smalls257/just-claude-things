<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CSharpFunctionalExtensions" Version="3.6.0" />
    <PackageVersion Include="Dapper" Version="2.1.66" />
    <PackageVersion Include="Npgsql" Version="8.0.5" />
    <!-- MediatR pinned: last MIT release before commercial pivot (Aug 2024). -->
    <PackageVersion Include="MediatR" Version="12.4.1" />
    <!-- MassTransit pinned: last MIT v8 release before commercial v9. -->
    <PackageVersion Include="MassTransit" Version="8.3.4" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.3.4" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.7" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!--
      The IDs below are emitted by `dotnet new webapi|worker|xunit` with
      explicit Version="..." attributes. After scaffolding, the strip step
      in scaffold.md removes those Version attributes; these pins keep the
      packages resolvable under ManagePackageVersionsCentrally=true.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.7" />
    <!-- Swagger UI only; OpenAPI spec is generated by Microsoft.AspNetCore.OpenApi above. -->
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.1.7" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>
</Project>
