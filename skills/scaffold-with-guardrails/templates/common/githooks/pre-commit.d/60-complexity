#!/usr/bin/env bash
# Tier: optional. Per-function cyclomatic complexity via lizard.
# Default in 'standard' profile: warn. In 'regulated' profile: fail.
set -uo pipefail
GATE="60-complexity"
GATE_DIR="$(dirname "${BASH_SOURCE[0]}")"
# shellcheck source=../_output.sh
. "$(dirname "$GATE_DIR")/_output.sh"

REPO_ROOT="${REPO_ROOT:-$(git rev-parse --show-toplevel)}"

# Applicability — staged source files. Self-skip before tool check (Infected Core).
# grep exit 1 = zero matches = empty $files → self-skip. Not Silent Fallback.
files=$(git diff --cached --name-only --diff-filter=ACM \
        | grep -E '\.(cs|py|ts|tsx|js|jsx|go|java)$' || true)
if [ -z "$files" ]; then
  exit 77
fi

TOOL="${REPO_ROOT}/.tools/lizard"
[ -x "$TOOL" ] || TOOL="$(command -v lizard 2>/dev/null || true)"
if [ -z "$TOOL" ] || [ ! -x "$TOOL" ]; then
  gate_missing_tool "$GATE" "lizard" "Optional: complexity gate."
  exit 2
fi

# Read profile + thresholds from .gates.toml. Defaults: standard / CCN 10 / NLOC 60.
# Ad-hoc grep parsing here; T18 will replace with proper resolver.
profile=$(grep -E '^profile' "$REPO_ROOT/.gates.toml" 2>/dev/null | head -1 | sed 's/.*"\(.*\)".*/\1/' || true)
[ -n "$profile" ] || profile="standard"
max_ccn=$(grep -E '^max_ccn' "$REPO_ROOT/.gates.toml" 2>/dev/null | head -1 | awk -F= '{print $2}' | tr -d ' "' || true)
[ -n "$max_ccn" ] || max_ccn=10
max_nloc=$(grep -E '^max_nloc' "$REPO_ROOT/.gates.toml" 2>/dev/null | head -1 | awk -F= '{print $2}' | tr -d ' "' || true)
[ -n "$max_nloc" ] || max_nloc=60

# Unquoted $files is intentional: word-split filenames into args.
# shellcheck disable=SC2086
out=$("$TOOL" --CCN "$max_ccn" --length "$max_nloc" $files 2>&1)
code=$?
if [ "$code" -ne 0 ]; then
  if [ "$profile" = "regulated" ]; then
    printf '%s\n' "$out" | gate_fail_block "$GATE" "lizard"
    echo "  Fix: extract sub-functions, simplify." >&2
    exit 1
  fi
  printf '%s\n' "$out" | gate_warn_block "$GATE" "lizard"
  echo "  Promote to error in .gates.toml when ready." >&2
fi
exit 0
