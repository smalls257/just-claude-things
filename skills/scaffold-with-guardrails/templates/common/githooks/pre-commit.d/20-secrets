#!/usr/bin/env bash
# Tier: critical. Blocks any leaked secret detected by gitleaks.
set -uo pipefail
GATE="20-secrets"
GATE_DIR="$(dirname "${BASH_SOURCE[0]}")"
# shellcheck source=../_output.sh
. "$(dirname "$GATE_DIR")/_output.sh"

REPO_ROOT="$(git rev-parse --show-toplevel)"
TOOL="${REPO_ROOT}/.tools/gitleaks"

if [ ! -x "$TOOL" ]; then
  gate_missing_tool "$GATE" "gitleaks" "Required for secret scanning."
  exit 2
fi

# Scan staged content. --redact masks secrets in output (still flags them).
if ! out=$("$TOOL" protect --staged --redact --no-banner 2>&1); then
  printf '%s\n' "$out" | gate_fail_block "$GATE" "gitleaks"
  echo "  Fix: remove the secret. If false positive, add a path/rule entry to .gitleaks.toml." >&2
  exit 1
fi
exit 0
